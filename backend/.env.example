APP_NAME="Fine Jewellery Buyers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.finejewellerybuyers.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fjb_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# SMTP (can also be configured via admin panel)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@finejewellerybuyers.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Admin notification email
ADMIN_EMAIL=admin@finejewellerybuyers.co.uk

# Frontend URL (for CORS — your Vercel / main domain)
FRONTEND_URL=https://finejewellerybuyers.co.uk

# Metal Rates API (fallback — primary config via admin panel)
# Supports: metalpriceapi (default) or goldapi
METAL_API_KEY=
METAL_API_PROVIDER=metalpriceapi

# Google Places API (fallback — primary config via admin panel)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Analytics / GTM (also configurable via admin panel)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Browser setup + URL cron (cPanel without SSH)
SETUP_SECRET=change-this-to-a-long-random-string
CRON_SECRET=change-this-to-another-long-random-string
