# Backend API URL (Laravel on cPanel)
NEXT_PUBLIC_API_URL=https://api.finejewellerybuyers.co.uk

# Public site URL (SEO, sitemap, canonical links) — must match live www host
NEXT_PUBLIC_SITE_URL=https://www.finejewellerybuyers.co.uk

# Optional analytics (also configurable in admin)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# Google Ads account tag (AW-XXXXXXXXXX). Digits-only values are auto-prefixed.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional conversion labels from Google Ads (Action → Tag setup). Needed for direct gtag conversions.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
# Microsoft Clarity project ID (Fine Jewellery Buyers → n7prrt2s5b)
NEXT_PUBLIC_CLARITY_ID=n7prrt2s5b
